# --- core ---
ENVIRONMENT=production
# docker-compose overrides DATABASE_URL; set it yourself when running without compose
DATABASE_URL=postgresql+psycopg://aaroh:CHANGE_ME@localhost:5432/aaroh
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
# Separate key that encrypts users' AI API keys at rest (generate the same way)
ENCRYPTION_KEY=CHANGE_ME_64_RANDOM_CHARS
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Comma-separated. https://localhost and capacitor://localhost are the Android app's origins.
CORS_ORIGINS=https://your-domain.example,https://localhost,capacitor://localhost
# true when served over HTTPS (required in production)
COOKIE_SECURE=true
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=8

# --- AI (optional) ---
# Without a key AAROH runs in a clearly labelled offline mode. Users can also add their own key in Settings.
# AI_PROVIDER: none | anthropic | openai_compatible
AI_PROVIDER=none
# Defaults: claude-opus-5-5 (anthropic), gpt-4o-mini (openai_compatible)
AI_MODEL=
ANTHROPIC_API_KEY=
# OpenAI-compatible endpoints: https://api.openai.com/v1, https://api.groq.com/openai/v1, http://ollama:11434/v1 ...
AI_BASE_URL=
OPENAI_API_KEY=
